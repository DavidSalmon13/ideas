# Copy to .env and adjust. Never commit .env.
OPP_DATABASE_URL=sqlite:///./data/opp.db
OPP_LOG_LEVEL=INFO
OPP_LOG_JSON=true

# Search provider (currently: tavily). The key is required before any real search.
OPP_SEARCH_PROVIDER=tavily
OPP_TAVILY_API_KEY=
OPP_SEARCH_COST_PER_CALL_USD=0.008
OPP_SEARCH_CACHE_TTL_HOURS=168

# Fetching: SSRF-guarded, capped per page.
OPP_FETCH_TIMEOUT_S=15
OPP_FETCH_MAX_BYTES=2000000
OPP_PAGE_CACHE_TTL_HOURS=720

# LLM. Leave the key empty to use ANTHROPIC_API_KEY or an `ant auth login` profile.
OPP_ANTHROPIC_API_KEY=
OPP_LLM_CHEAP_MODEL=claude-haiku-4-5
OPP_LLM_MEDIUM_MODEL=claude-sonnet-5
OPP_LLM_PREMIUM_MODEL=claude-sonnet-5
OPP_LLM_PREMIUM_OPUS_MODEL=claude-opus-4-8

# A run budget above this needs --over-max (specs.md §21.1).
OPP_MAX_BUDGET_USD=20

# Per-agent research budgets (USD caps; call caps are settings too, see settings.py).
OPP_DISCOVERY_MAX_COST_USD=0.75
OPP_TRIAGE_MAX_COST_USD=1.0
OPP_SHALLOW_MAX_COST_USD=3.0
OPP_SHALLOW_MAX_FETCHES=5
