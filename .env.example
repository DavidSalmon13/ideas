# Copy to .env and adjust. Never commit .env.
OPP_DATABASE_URL=sqlite:///./data/opp.db
OPP_LOG_LEVEL=INFO
OPP_LOG_JSON=true

# Search provider (currently: tavily). The key is required before any real search.
OPP_SEARCH_PROVIDER=tavily
OPP_TAVILY_API_KEY=
OPP_SEARCH_COST_PER_CALL_USD=0.008
OPP_SEARCH_CACHE_TTL_HOURS=168

# Fetching: SSRF-guarded, capped per page.
OPP_FETCH_TIMEOUT_S=15
OPP_FETCH_MAX_BYTES=2000000
OPP_PAGE_CACHE_TTL_HOURS=720
